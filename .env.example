# Behaive Arena — copy to .env and fill in real values. Never commit .env.
#
# -----------------------------------------------------------------------
# NEW HOSTED PLATFORM (apps/web + apps/worker, landing W1 onwards)
# -----------------------------------------------------------------------

# Supabase project (free tier)
#   Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
#   Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#   Settings → API → service_role key. Server-side only. Never ship to browser.
SUPABASE_SERVICE_ROLE_KEY=
#   Settings → Database → Connection string (pooler). Used by pg-boss + Drizzle.
SUPABASE_DB_URL=

# Base Sepolia RPC (Alchemy free tier recommended; public fallback works)
BASE_SEPOLIA_RPC=https://sepolia.base.org

# On-chain contract addresses — filled in after `forge script Deploy` runs.
AGENT_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
IDENTITY_RESOLVER_ADDRESS=

# Platform signer — the hot wallet that relays reputation writes on-chain.
# 0x-prefixed 32-byte hex. Separate from any researcher / agent wallet.
PLATFORM_SIGNER_KEY=

# Deploy-time only. Leave unset in normal operation.
DEPLOYER_PRIVATE_KEY=
BASESCAN_API_KEY=

# Worker logging
LOG_LEVEL=info

# -----------------------------------------------------------------------
# LEGACY (relay-daemon.js + Daytona sandbox) — remove once Week 4-5 ships
# -----------------------------------------------------------------------

# Anthropic (OpenClaw/Claude)
ANTHROPIC_API_KEY=

# Telegram bot tokens (from @BotFather, one per agent)
TG_RESEARCHER_TOKEN=
TG_PROPOSER_TOKEN=
TG_RESPONDER_TOKEN=

# USDC on Base Sepolia (default below is correct for testnet)
USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Legacy hardcoded agent wallet keys (will be replaced by per-run ephemeral wallets)
RESEARCHER_PRIVATE_KEY=
RESEARCHER_ADDRESS=0x4B727B5947AEDb36545cCBDC16E2a81B837C0103
PROPOSER_PRIVATE_KEY=
PROPOSER_ADDRESS=0xB4305A685E7370b170F5005A4efd268e3DdB2A6E
RESPONDER_PRIVATE_KEY=
RESPONDER_ADDRESS=0x328DB42692f438Ab8D9e020Ac63ebF72508e7D34

# Daytona (for deploy-to-daytona.js only)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Relay daemon
TELEGRAM_GROUP_ID=              # Your Telegram group chat ID (negative number)
WEBHOOK_URL=                    # Optional: URL for relay webhook payloads (e.g. web UI)
WEBHOOK_SECRET=                 # Optional: HMAC-SHA256 shared secret for X-Webhook-Signature

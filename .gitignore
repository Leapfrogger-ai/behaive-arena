# Dependencies
node_modules/
.pnpm-store/

# Environment and secrets — never commit
.env
.env.local
.env.*.local
*.pem
config/openclaw.json

# Next.js build output
apps/web/.next/
apps/web/out/

# TypeScript / worker build output
apps/worker/dist/
packages/*/dist/
**/*.tsbuildinfo

# Foundry build output + caches + broadcast files (contain tx hashes, addresses)
packages/contracts/out/
packages/contracts/cache/
packages/contracts/broadcast/

# OS and editor
.DS_Store
*.log
.idea/
.vscode/
.turbo/

# Optional: local OpenClaw state
# .openclaw/
# Foundry libs pulled from GitHub — we don't vendor these
packages/contracts/lib/

{
  "name": "behaive-arena",
  "version": "0.1.0",
  "private": true,
  "description": "Hosted research platform for on-chain behavioral-economics experiments with AI agents.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter @behaive/web dev",
    "dev:worker": "pnpm --filter @behaive/worker dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "legacy:relay": "node relay-daemon.js"
  },
  "dependencies": {
    "openclaw": "^2026.2.19-2"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}

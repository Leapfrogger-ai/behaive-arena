{
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-sonnet-4-5"
      }
    },
    "list": [
      {
        "id": "researcher",
        "name": "Researcher",
        "workspace": "~/.openclaw/workspace-researcher"
      },
      {
        "id": "proposer",
        "name": "Proposer",
        "workspace": "~/.openclaw/workspace-proposer"
      },
      {
        "id": "responder",
        "name": "Responder",
        "workspace": "~/.openclaw/workspace-responder"
      }
    ]
  },
  "bindings": [
    {
      "agentId": "researcher",
      "match": {
        "channel": "telegram",
        "accountId": "researcher"
      }
    },
    {
      "agentId": "proposer",
      "match": {
        "channel": "telegram",
        "accountId": "proposer"
      }
    },
    {
      "agentId": "responder",
      "match": {
        "channel": "telegram",
        "accountId": "responder"
      }
    }
  ],
  "channels": {
    "telegram": {
      "enabled": true,
      "groupPolicy": "allowlist",
      "streamMode": "partial",
      "accounts": {
        "researcher": {
          "botToken": "${TG_RESEARCHER_TOKEN}"
        },
        "proposer": {
          "botToken": "${TG_PROPOSER_TOKEN}"
        },
        "responder": {
          "botToken": "${TG_RESPONDER_TOKEN}"
        }
      },
      "groups": {
        "-5170132029": {
          "requireMention": true
        }
      }
    }
  }
}
